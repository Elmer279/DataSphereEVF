rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
             data.role in ['teacher', 'admin', 'focal_person'];
    }

    // Validation for Learner
    function isValidLearner(data) {
      return data.keys().hasAll(['id']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128;
    }

    // Validation for AttendanceLog
    function isValidAttendanceLog(data) {
      return data.keys().hasAll(['id', 'name', 'action', 'session', 'clc', 'timestamp']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.action in ['TIME IN', 'TIME OUT'] &&
             data.session in ['Morning Session', 'Afternoon Session'] &&
             data.clc is string && data.clc.size() > 0 && data.clc.size() <= 150 &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 60;
    }

    // Validation for SheetCache
    function isValidSheetCache(data) {
      return data.keys().hasAll(['id', 'spreadsheetId', 'tabName', 'syncedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.spreadsheetId is string && data.spreadsheetId.size() > 0 &&
             data.tabName is string && data.tabName.size() > 0;
    }

    // Validation for ClassProgramSchedule
    function isValidClassProgram(data) {
      return data.keys().hasAll(['id', 'teacherName']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 150;
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // Enrolled & Mapped Learners (Real-time Synced from Google Sheets)
    match /learners/{learnerId} {
      allow read: if true;
      allow create: if isValidId(learnerId) && isValidLearner(incoming());
      allow update: if isValidId(learnerId) && isValidLearner(incoming());
      allow delete: if isValidId(learnerId);
    }

    // Real-time Digital Attendance Logs
    match /attendance_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidAttendanceLog(incoming());
      allow update: if isValidId(logId) && isValidAttendanceLog(incoming());
      allow delete: if isValidId(logId);
    }

    // Synced Google Sheets Cache
    match /sheets_cache/{cacheId} {
      allow read: if true;
      allow create: if isValidId(cacheId) && isValidSheetCache(incoming());
      allow update: if isValidId(cacheId) && isValidSheetCache(incoming());
      allow delete: if isValidId(cacheId);
    }

    // Facilitator Class Program Schedules
    match /class_programs/{programId} {
      allow read: if true;
      allow create: if isValidId(programId) && isValidClassProgram(incoming());
      allow update: if isValidId(programId) && isValidClassProgram(incoming());
      allow delete: if isValidId(programId);
    }
  }
}
